# Copy to .env (gitignored) and fill in real values. `source .env` before running scripts.
# Discipline (NEW-PROJECT-GUIDE §6): NOTHING identity-specific is hardcoded in device/app/web
# source. Every value below is a runtime field/import. Real values live here or in private/.

# --- Devices (see private/network-inventory.md for the real reservations) ---
MONITOR_ID=shellyplusi4-XXXXXXXXXXXX     # i4 DC — monitoring unit (door state)
MONITOR_IP=192.0.2.XXX
CONTROLLER_ID=shelly1g3-XXXXXXXXXXXX     # Shelly 1 Gen3 — controlling unit (relay)
CONTROLLER_IP=192.0.2.XXX

# --- Local MQTT broker (Mosquitto, mTLS) — see mqtt-leiflan ---
MQTT_LOCAL_HOST=192.0.2.130
MQTT_LOCAL_PORT=8883
# mTLS client identity per device (CN = device id). Real .p12 + CA public cert live in private/,
# provisioned onto each Shelly via RPC Mqtt.SetConfig — never committed, never bundled.
MQTT_CA_CERT=private/ca.crt
MONITOR_CLIENT_P12=private/monitor-client.p12
CONTROLLER_CLIENT_P12=private/controller-client.p12

# --- Cloud MQTT (EMQX Serverless, reached via broker bridge of devices/#) ---
MQTT_CLOUD_HOST=
MQTT_CLOUD_USER=
MQTT_CLOUD_PASS=
