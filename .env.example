# Copy to .env (gitignored) and fill in real values. `source .env` before running scripts.
# Discipline (NEW-PROJECT-GUIDE §6): NOTHING identity-specific is hardcoded in device/app/web
# source. Every value below is a runtime field/import. Real values live here or in private/.

# --- Devices: RPC addressing (the Shelly's own hostname/IP — see private/network-inventory.md) ---
MONITOR_HOST=192.0.2.160               # i4 DC — monitoring unit (door state)
CONTROLLER_HOST=192.0.2.161            # Shelly 1 Gen3 — controlling unit (relay)

# --- MQTT identities (CN = topic root; D-15). Distinct from the Shelly hostname above. ---
MONITOR_CN=garage-monitor                # → devices/garage-monitor/… + mon/garage-monitor/alive
CONTROLLER_CN=garage-controller          # → devices/garage-controller/… (command/config/heartbeat)

# --- Local MQTT broker (Mosquitto, mTLS) — see mqtt-leiflan / docs/spec/11 ---
MQTT_LOCAL_HOST=192.0.2.130
MQTT_LOCAL_PORT=8883
# Per-device mTLS material (ECDSA P-256, PEM, unencrypted key), delivered by the broker maintainers.
# Kept in private/ (gitignored), uploaded to each Shelly via Shelly.PutUserCA/PutTLSClientCert/Key.
MQTT_CA_CERT=private/ca.crt
MONITOR_CLIENT_CRT=private/garage-monitor.crt
MONITOR_CLIENT_KEY=private/garage-monitor.key
CONTROLLER_CLIENT_CRT=private/garage-controller.crt
CONTROLLER_CLIENT_KEY=private/garage-controller.key

# --- Cloud MQTT (EMQX Serverless, reached via broker bridge of devices/#) — broker-side concern ---
MQTT_CLOUD_HOST=
MQTT_CLOUD_USER=
MQTT_CLOUD_PASS=
