<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:name="android.hardware.type.watch" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Lets the system bind our watch-face complication data source (spec 17). -->
    <uses-permission android:name="com.google.android.wearable.permission.BIND_COMPLICATION_PROVIDER" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.GarageWear">

        <uses-library android:name="com.google.android.wearable" android:required="true" />
        <!-- Tethered: leans on the phone app (Phase 2b). Not a standalone Play listing. -->
        <meta-data android:name="com.google.android.wearable.standalone" android:value="false" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.GarageWear">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Watch-face complication: renders door state, taps open MainActivity (spec 17 Phase 2c).
             SMALL_IMAGE keeps our colours; MONOCHROMATIC_ICON / SHORT_TEXT are fallbacks. Zero background
             work: no periodic polling (UPDATE_PERIOD_SECONDS=0) and NO background DATA_CHANGED listener —
             the app refreshes it while foregrounded and on tap. This keeps the watch's Wear OS chip asleep
             (the OnePlus dual-engine battery win) at the cost of live-on-glance updates. -->
        <service
            android:name=".complication.GarageComplicationService"
            android:exported="true"
            android:icon="@drawable/ic_comp_garage_closed"
            android:label="@string/complication_label"
            android:permission="com.google.android.wearable.permission.BIND_COMPLICATION_PROVIDER">
            <intent-filter>
                <action android:name="android.support.wearable.complications.ACTION_COMPLICATION_UPDATE_REQUEST" />
            </intent-filter>
            <!-- Legacy wire-name tokens (TYPE_ prefix dropped): ICON == MONOCHROMATIC_IMAGE request type. -->
            <meta-data
                android:name="android.support.wearable.complications.SUPPORTED_TYPES"
                android:value="SMALL_IMAGE,ICON,SHORT_TEXT" />
            <meta-data
                android:name="android.support.wearable.complications.UPDATE_PERIOD_SECONDS"
                android:value="0" />
        </service>
    </application>

</manifest>
