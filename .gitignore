# Credentials — never commit these
*.env
secrets.*

# Private local-only dir: ALL real keys/certs/creds/network inventory + the
# NEW-PROJECT-GUIDE live here. Anything under private/ is ignored.
private/

# Android Studio / Gradle build artifacts (any module — app/, wear/, …)
**/.gradle/
**/build/
**/local.properties
**/.idea/
**/*.iml
app/captures/
app/.externalNativeBuild/
# Note: app/debug.keystore + wear/debug.keystore are intentionally TRACKED (non-sensitive shared debug key)

# OS files
.DS_Store
Thumbs.db

# Editor files
*.swp
*.swo
*~
.vscode/

# soak/test run logs
logs/
